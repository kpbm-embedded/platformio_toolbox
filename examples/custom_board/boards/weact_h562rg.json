{
  "build": {
    "core": "stm32",
    "cpu": "cortex-m33",
    "extra_flags": "-DSTM32H5 -DSTM32H5xx -DSTM32H562xx",
    "f_cpu": "250000000L",
    "mcu": "stm32h562rgt6",
    "product_line": "STM32H562xx",
    "variant": "STM32H5xx/H562R(G-I)T"
  },
  "debug": {
    "jlink_device": "STM32H562RG",
    "openocd_target": "stm32h5x",
    "svd_path": "STM32H562.svd"
  },
  "frameworks": ["arduino"],
  "name": "WeAct STM32H562RGT6 core board (custom board, 32_14_platformio)",
  "upload": {
    "maximum_ram_size": 655360,
    "maximum_size": 1048576,
    "protocol": "dfu",
    "protocols": ["dfu", "stlink", "jlink"]
  },
  "url": "https://github.com/WeActStudio/WeActStudio.STM32H5_64Pin_CoreBoard",
  "vendor": "WeAct Studio"
}
